#!/usr/bin/env bash
# fzf-install: fuzzy-search dnf packages (installed shown in green) and install selection(s)

set -euo pipefail

selected=$(dnf --color=always list \
    | grep -Ev '^(Installed|Available) Packages$' \
    | fzf --ansi --multi --prompt="Install> " \
          --preview 'dnf info $(echo {1} | sed "s/\x1b\[[0-9;]*m//g")' \
          --preview-window=right:60%)

if [[ -z "$selected" ]]; then
    echo "No package selected."
    exit 0
fi

echo "$selected" \
    | sed 's/\x1b\[[0-9;]*m//g' \
    | awk '{print $1}' \
    | xargs sudo-rs dnf install -y

